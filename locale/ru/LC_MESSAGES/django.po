#: apps/accounts/adapters.py:49
#, python-format
msgid "Confirm your e-mail address — %(site)s"
msgstr "Подтвердите адрес e-mail — %(site)s"

#: apps/accounts/adapters.py:51
#, python-format
msgid ""
"Thank you for registering with %(site)s.\n"
"\n"
"Please confirm your e-mail address by opening this link:\n"
"\n"
"%(url)s\n"
"\n"
"The link is valid for three days. If you did not create an account, you can ignore this message."
msgstr ""
"Спасибо за регистрацию в %(site)s.\n"
"\n"
"Подтвердите адрес e-mail, открыв эту ссылку:\n"
"\n"
"%(url)s\n"
"\n"
"Ссылка действует три дня. Если вы не создавали аккаунт, просто проигнорируйте это письмо."

#: apps/accounts/adapters.py:59
#, python-format
msgid "Reset your password — %(site)s"
msgstr "Сброс пароля — %(site)s"

#: apps/accounts/adapters.py:61
#, python-format
msgid ""
"Someone asked to reset the password for your %(site)s account.\n"
"\n"
"Choose a new password here:\n"
"\n"
"%(url)s\n"
"\n"
"If this was not you, no action is needed — your password stays as it is."
msgstr ""
"Кто-то запросил сброс пароля для вашего аккаунта в %(site)s.\n"
"\n"
"Выберите новый пароль здесь:\n"
"\n"
"%(url)s\n"
"\n"
"Если это были не вы, ничего делать не нужно — пароль останется прежним."

