# =============================================================================
# ALGORITHM: Review of Economic Research (ARER) — environment configuration
# Copy to .env:  cp .env.example .env
# Every value below is a SAFE DEVELOPMENT DEFAULT. Replace the ones marked
# "REPLACE IN PRODUCTION" before going live (see docs/DEPLOYMENT.md).
# =============================================================================

# --- Django core -------------------------------------------------------------
# REPLACE IN PRODUCTION: generate with `make secret`
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-0123456789abcdef
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Site identity -----------------------------------------------------------
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http
SITE_NAME=ALGORITHM: Review of Economic Research

# --- Database (PostgreSQL 16) ------------------------------------------------
# DB_POOL=true turns on psycopg's connection pool (recommended in production;
# CONN_MAX_AGE is then ignored). DB_POOL_MAX is per gunicorn worker process.
DB_POOL=false
DB_POOL_MIN=1
DB_POOL_MAX=4
# GUNICORN_WORKERS defaults to 2xCPU+1 (max 12); GUNICORN_THREADS to 4.
GUNICORN_WORKERS=
GUNICORN_THREADS=4
POSTGRES_DB=arer
POSTGRES_USER=arer
POSTGRES_PASSWORD=arer_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://arer:arer_dev_password@db:5432/arer
CONN_MAX_AGE=60

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Email -------------------------------------------------------------------
# dev: Mailpit (http://localhost:8025). prod: set EMAIL_BACKEND to Anymail/Resend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=editor@localhost
SERVER_EMAIL=server@localhost
# REPLACE IN PRODUCTION: https://resend.com/api-keys
RESEND_API_KEY=

# --- DOI / Crossref ----------------------------------------------------------
# REPLACE IN PRODUCTION: Crossref membership gives a real prefix (10.xxxxx)
DOI_PREFIX=10.00000
CROSSREF_TEST=True
CROSSREF_DEPOSIT_URL=https://test.crossref.org/servlet/deposit
CROSSREF_DEPOSIT_URL_PROD=https://doi.crossref.org/servlet/deposit
CROSSREF_USER=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME=ARER Editorial Office
CROSSREF_DEPOSITOR_EMAIL=editor@localhost
CROSSREF_REGISTRANT=ALGORITHM Review of Economic Research
CROSSREF_POLITE_MAILTO=editor@localhost

# --- ORCID -------------------------------------------------------------------
# REPLACE IN PRODUCTION: https://orcid.org/developer-tools (Public API)
ORCID_BASE=sandbox
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Google sign-in ------------------------------------------------------------
# Optional. Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials and add
# https://<SITE_DOMAIN>/accounts/google/login/callback/ as an authorised
# redirect URI. The "Sign in with Google" button appears only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign-up -------------------------------------------------------------------
# none (default): accounts are active immediately; mandatory: the user must open
# the confirmation link first (needs a working e-mail backend).
ACCOUNT_EMAIL_VERIFICATION=none

# --- First start ---------------------------------------------------------------
# The production entrypoint seeds policy pages, sections and JEL codes when the
# database is empty. Set to true on a STAGING service to also load the demo
# accounts, articles and submissions (never on the real site).
SEED_DEMO_ON_START=false
# Run migrations + first-start seeding when a `prod` container starts. Kubernetes
# sets false and runs them once in the arer-migrate Job instead.
MIGRATE_ON_START=true

# --- Observability (docs/PIPELINE_uz.md) --------------------------------------
# text (human-readable) or json (one JSON object per line, for Fluent Bit/ELK).
LOG_FORMAT=text
LOG_LEVEL=INFO
# Reported in JSON logs and traces. APP_VERSION is baked into the image by CI.
APP_ENV=development
# Distributed tracing is OFF while this is empty. Point it at an OpenTelemetry
# Collector (or Jaeger with COLLECTOR_OTLP_ENABLED) over OTLP/HTTP, e.g.
# http://otel-collector.monitoring.svc.cluster.local:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arer-web
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Plagiarism --------------------------------------------------------------
PLAGIARISM_PROVIDER=manual
ITHENTICATE_URL=
ITHENTICATE_API_KEY=

# --- Storage -----------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Analytics (optional, self-hosted Matomo) --------------------------------
MATOMO_URL=
MATOMO_SITE_ID=

# --- Security ----------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
IP_HASH_SALT=dev-ip-hash-salt-change-me
CLAMAV_HOST=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# --- Backups -----------------------------------------------------------------
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_TARGET=

# --- Published host ports (docker compose) ------------------------------------
# Only the ports Docker publishes on *your machine*.  Leave them alone unless
# something else already listens there; the containers always talk to each other
# on db:5432, redis:6379 and mailpit:1025 regardless of what is set here.
WEB_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MATOMO_PORT=8080
